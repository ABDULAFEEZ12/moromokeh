# --- Core ---
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me
FLASK_ENV=production
# Set to your real domain in production, e.g. https://moromokeh.com
SITE_URL=http://localhost:5000

# --- Database ---
# MongoDB Atlas connection string. Use "mongomock" only for local dev without a real database.
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGO_DB_NAME=moromokeh

# --- Admin bootstrap (used only by seed_admin.py, never read at request time) ---
ADMIN_EMAIL=owner@moromokeh.com
ADMIN_PASSWORD=change-me-now

# --- Payments: SquadCo (https://docs.squadco.com) ---
# Secret key from your Squad dashboard (Settings > API & Webhook). Starts with
# "sandbox_sk_" for a Sandbox account, or your live secret key once approved.
# Leave blank in dev to run with payments disabled (checkout will show a clear
# "unavailable" message and the order is still recorded as pending).
SQUADCO_SECRET_KEY=
# "sandbox" while testing against a Sandbox account, "live" once you switch to
# your live secret key. Selects which of SquadCo's two base URLs is called -
# no separate variable for the URL itself.
SQUADCO_ENV=sandbox
# Also required, but configured on SquadCo's dashboard, not here:
# Dashboard > Profile > API & Webhook ->
#   Webhook URL:  https://<your-domain>/webhooks/squadco
#   Redirect URL: optional per SquadCo's docs - this app always sends its own
#                 callback_url with every /transaction/initiate call, so the
#                 dashboard value (if any) is only a fallback.

# --- Order notification email (optional, best-effort, never blocks an order) ---
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
ORDER_NOTIFY_EMAIL=owner@moromokeh.com

# --- Uploads ---
MAX_UPLOAD_MB=8
